fn evalA(i: Int, j: Int): Float {
    let ij = i + j;
    return 1.0 / Float((ij * (ij + 1) / 2) + i + 1);
}

fn timesAv(v: Array<Float>, out: Array<Float>, n: Int) {
    let i = 0;
    while i < n {
        let s = 0.0;
        let j = 0;
        while j < n {
            s = s + evalA(i, j) * v[j];
            j = j + 1;
        }
        out[i] = s;
        i = i + 1;
    }
}

fn timesA(v: Array<Float>, out: Array<Float>, n: Int) {
    let i = 0;
    while i < n {
        let s = 0.0;
        let j = 0;
        while j < n {
            s = s + evalA(j, i) * v[j];
            j = j + 1;
        }
        out[i] = s;
        i = i + 1;
    }
}


let n = 300;
let u: Array<Float> = [];
let v: Array<Float> = [];
let w: Array<Float> = [];
let i = 0;
while i < n {
    u.push(1.0);
    v.push(0.0);
    w.push(0.0);
    i = i + 1;
}
let it = 0;
while it < 10 {
    timesAv(u, w, n);
    timesA(w, v, n);
    timesAv(v, w, n);
    timesA(w, u, n);
    it = it + 1;
}
let vBv = 0.0;
let vv = 0.0;
let k = 0;
while k < n {
    vBv = vBv + u[k] * v[k];
    vv = vv + v[k] * v[k];
    k = k + 1;
}
print("spectral checksum =", Int(vBv / vv * 1000000.0));
