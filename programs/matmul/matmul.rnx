fn Main(): Int {
    let n = 256;
    let a: Array<Int> = [];
    let b: Array<Int> = [];
    let c: Array<Int> = [];
    let i = 0;
    while i < n * n {
        let r = i / n;
        let col = i - r * n;
        a.push(((r * 7 + col * 13) % 16) - 8);
        b.push(((r * 13 - col * 7) % 16) - 8);
        c.push(0);
        i = i + 1;
    }
    let r = 0;
    while r < n {
        let k = 0;
        while k < n {
            let aik = a[r * n + k];
            let j = 0;
            while j < n {
                c[r * n + j] = c[r * n + j] + aik * b[k * n + j];
                j = j + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    let sum = 0;
    let q = 0;
    while q < n * n {
        sum = sum + c[q];
        q = q + 1;
    }
    print("matmul checksum =", sum);
    return 0;
}
